# Web app environment — copy to .env.local and fill in real values.
# Only VITE_ prefixed vars are exposed to the browser bundle.
# Never put server secrets or private keys here.

# ---------------------------------------------------------------------------
# API base URL (no trailing slash — apiClient appends /v1 internally)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8787

# ---------------------------------------------------------------------------
# Clerk publishable key (safe to expose — public key only, not secret key)
# ---------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# ---------------------------------------------------------------------------
# Dev auth bypass (development only — remove or set to false in staging/production)
# ---------------------------------------------------------------------------
# When true, the frontend sends a hardcoded dev token that the API accepts
# only when DEV_AUTH_ENABLED=true and ENVIRONMENT=development on the server.
VITE_DEV_AUTH_TOKEN_ENABLED=true

# ---------------------------------------------------------------------------
# Observability (Sentry + PostHog) — disabled by default, safe to leave empty
# ---------------------------------------------------------------------------
# Set VITE_OBSERVABILITY_ENABLED=true and fill in real values for staging/production.
# App runs normally when any of these are absent.
VITE_OBSERVABILITY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
