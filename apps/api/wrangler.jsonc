{
  "name": "orra-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "R2_ACCOUNT_ID": "<your-account-id>",
    "R2_BUCKET_NAME": "orra-assets"
  },
  "queues": {
    "producers": [
      {
        "binding": "GENERATION_QUEUE",
        "queue": "orra-generation-queue"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ORRA_ASSETS",
      "bucket_name": "orra-assets"
    }
  ],
  "env": {
    "staging": {
      "observability": {
        "enabled": true
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "R2_ACCOUNT_ID": "745be7de68c0f2a97f14964da20be6d7",
        "R2_BUCKET_NAME": "orra-assets-staging",
        "PROMPT_ENHANCER_MODE": "ai",
        // To use Gemini for prompt enhancer:
        "AI_PROVIDER": "gemini",
        "GEMINI_TEXT_MODEL": "gemini-2.0-flash-lite",
        // To use OpenAI instead: set AI_PROVIDER=openai and OPENAI_TEXT_MODEL=gpt-4o-mini
        // Then: wrangler secret put OPENAI_API_KEY --env staging
        "ALLOWED_ORIGINS": "https://orra-web.pages.dev,https://*.orra-web.pages.dev"
        // GEMINI_API_KEY is a secret — set via: wrangler secret put GEMINI_API_KEY --env staging
      },
      "queues": {
        "producers": [
          {
            "binding": "GENERATION_QUEUE",
            "queue": "orra-generation-queue-staging"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "ORRA_ASSETS",
          "bucket_name": "orra-assets-staging"
        }
      ]
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "R2_ACCOUNT_ID": "745be7de68c0f2a97f14964da20be6d7",
        "R2_BUCKET_NAME": "orra-assets",
        "PROMPT_ENHANCER_MODE": "ai",
        "AI_PROVIDER": "gemini",
        "GEMINI_TEXT_MODEL": "gemini-2.0-flash-lite"
        // GEMINI_API_KEY is a secret — set via: wrangler secret put GEMINI_API_KEY --env production
      },
      "queues": {
        "producers": [
          {
            "binding": "GENERATION_QUEUE",
            "queue": "orra-generation-queue"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "ORRA_ASSETS",
          "bucket_name": "orra-assets"
        }
      ]
    }
  }
}

// Secrets (set via `wrangler secret put [--env staging|production]` — never commit real values):
//   SUPABASE_URL                — Supabase project URL
//   SUPABASE_SERVICE_ROLE_KEY   — Supabase service role key
//   CLERK_SECRET_KEY            — Clerk secret key
//   CLERK_JWKS_URL              — Clerk JWKS endpoint URL
//   CLERK_JWT_ISSUER            — Clerk JWT issuer URL
//   CLERK_AUDIENCE              — Clerk audience (optional)
//   R2_ACCESS_KEY_ID            — R2 S3-compatible access key
//   R2_SECRET_ACCESS_KEY        — R2 S3-compatible secret key
//   ALLOWED_ORIGINS             — Comma-separated allowed CORS origins (set as var in wrangler.jsonc, not a secret)
//   INITIAL_CREDIT_GRANT        — Credits granted on first workspace creation (default 0)
//   PRIVATE_ALPHA_EMAIL_ALLOWLIST — Comma-separated emails for private-alpha access (optional; if unset, all Clerk users are allowed)
//   GEMINI_API_KEY               — Gemini API key for prompt enhancement (required when PROMPT_ENHANCER_MODE=ai and AI_PROVIDER=gemini)
//   OPENAI_API_KEY               — OpenAI API key for prompt enhancement (required when PROMPT_ENHANCER_MODE=ai and AI_PROVIDER=openai)
//
// R2 bucket CORS policy required for browser uploads:
//   Allowed methods: PUT
//   Allowed headers: Content-Type
//   Allowed origins: your app domain (staging or production)
//
// Upload flow:
//   1. Client requests upload intent → server returns presigned PUT URL
//   2. Client PUTs file bytes directly to the presigned URL
//   3. Server confirms upload and returns safe asset DTO
